# ---- Rowdy's Den frontend — example environment ----
# Copy to `.env` for local dev. Public (non-secret) values only.

# Where the FastAPI backend lives. In local dev, keep `/api` and let the
# Vite dev server proxy it to the backend (see vite.config.ts).
VITE_API_URL=/api

# Google OAuth 2.0 **Web application** Client ID (public value).
# Must match the backend GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Show the development-only email sign-in form. Must be false in production.
VITE_AUTH_DEV_MODE=true
